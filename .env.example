# Textical Godot MCP Configuration
# Copy this file to .env and modify the values

# Path to Godot executable (leave empty for auto-detect)
GODOT_PATH=

# Path to Textical Godot project
GODOT_PROJECT_PATH=./client

# Enable debug mode
DEBUG_MODE=true

# Server configuration
MCP_SERVER_PORT=3001
MCP_SERVER_HOST=localhost

# Timeout for Godot operations (milliseconds)
GODOT_TIMEOUT=30000

# Log level (debug, info, warn, error)
LOG_LEVEL=debug

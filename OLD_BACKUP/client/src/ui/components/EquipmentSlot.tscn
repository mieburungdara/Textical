[gd_scene load_steps=8 format=3 uid="uid://equipment_slot"]

[sub_resource type="GDScript" id="GDScript_slot"]
script/source = "extends PanelContainer
class_name EquipmentSlotUI

signal slot_clicked(slot_key)

@onready var icon_texture = $Margin/Icon
@onready var slot_name_label = $Margin/SlotName
@onready var quality_border = $QualityBorder
@onready var empty_icon = $EmptyIcon
@onready var glow_effect = $GlowEffect

var slot_key: String = \"\"
var is_empty: bool = true
var item_data: Dictionary = {}

func setup(p_key: String, p_display_name: String, p_empty_icon: String = \"❓\"):
	slot_key = p_key
	slot_name_label.text = p_display_name
	empty_icon.text = p_empty_icon
	set_empty()

func set_item(data: Dictionary):
	item_data = data
	is_empty = false
	empty_icon.visible = false
	# In a real game, you'd set a texture here
	slot_name_label.text = data.get(\"name\", \"Item\")
	slot_name_label.modulate = Color(1, 1, 1, 1)
	
	var quality = data.get(\"rarity\", \"COMMON\")
	_update_quality_visual(quality)

func set_empty():
	item_data = {}
	is_empty = true
	empty_icon.visible = true
	icon_texture.visible = false
	slot_name_label.text = \"Empty\"
	slot_name_label.modulate = Color(1, 1, 1, 0.2)
	_update_quality_visual(\"NONE\")

func _update_quality_visual(quality: String):
	var color = Color(0.3, 0.25, 0.2, 0.2) # Default
	var glow_color = Color(1, 1, 1, 0)
	
	match quality.to_upper():
		\"COMMON\": 
			color = Color(0.8, 0.8, 0.8, 0.6)
			glow_color = Color(0.8, 0.8, 0.8, 0.1)
		\"RARE\": 
			color = Color(0.2, 0.6, 1.0, 0.8)
			glow_color = Color(0.2, 0.6, 1.0, 0.2)
		\"EPIC\": 
			color = Color(0.7, 0.3, 1.0, 0.8)
			glow_color = Color(0.7, 0.3, 1.0, 0.2)
		\"LEGENDARY\": 
			color = Color(1.0, 0.7, 0.2, 0.9)
			glow_color = Color(1.0, 0.7, 0.2, 0.3)
		\"NONE\": 
			color = Color(1, 1, 1, 0.05)
			glow_color = Color(0, 0, 0, 0)
	
	if quality_border:
		var style: StyleBoxFlat = quality_border.get_theme_stylebox(\"panel\").duplicate()
		style.border_color = color
		quality_border.add_theme_stylebox_override(\"panel\", style)
	
	if glow_effect:
		var glow_style: StyleBoxFlat = glow_effect.get_theme_stylebox(\"panel\").duplicate()
		glow_style.bg_color = glow_color
		glow_effect.add_theme_stylebox_override(\"panel\", glow_style)

func _ready():
	mouse_entered.connect(_on_mouse_entered)
	mouse_exited.connect(_on_mouse_exited)

func _on_mouse_entered():
	modulate = Color(1.3, 1.3, 1.3, 1.0)
	scale = Vector2(1.08, 1.08)
	z_index = 5

func _on_mouse_exited():
	modulate = Color(1.0, 1.0, 1.0, 1.0)
	scale = Vector2(1.0, 1.0)
	z_index = 0

func _gui_input(event):
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		slot_clicked.emit(slot_key)
"


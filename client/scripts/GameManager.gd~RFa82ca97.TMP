extends Node
class_name GameManager

## Manages global game state
## Singleton - accessible from anywhere

# Constants
const MAX_HEROES: int = 50
const MAX_INVENTORY_SLOTS: int = 30

# Player resources
var gold: int = 0
var silver: int = 0

# Hero roster
var hero_count: int = 1
var heroes: Array = []

# Inventory & Equipment
var inventory: Array = []  # Array of item dictionaries
var equipment: Dictionary = {}  # {weapon, armor, helmet, boots, accessory}

# Quest tracking
var active_quests: int = 0

# World state
var current_day: int = 1

signal gold_changed(old_value: int, new_value: int)
signal hero_count_changed(old_count: int, new_count: int)
signal quest_updated(quest_count: int)

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	# TODO: Load heroes from server database
	# For now, using hardcoded sample data for UI testing
	_init_default_heroes()

# =============================================================================
# TODO: Implement server database loading
# =============================================================================
# - Load hero data from server API (server/src/players/)
# - Hero stats, equipment, skills from database
# - Use Socket.IO or REST API to fetch player roster
# - Handle offline/online states
# - Sync hero data on login/level up/equipment change
# =============================================================================


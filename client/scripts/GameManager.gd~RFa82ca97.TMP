func add_gold(amount: int) -> void:
    if amount <= 0:
        return
    var old_gold = gold
    gold += amount
    gold_changed.emit(old_gold, gold)

func spend_gold(amount: int) -> bool:
    if amount <= 0 or gold < amount:
        return false
    var old_gold = gold
    gold -= amount
    gold_changed.emit(old_gold, gold)
    return true

func add_hero(hero_data: Dictionary) -> bool:
    if hero_count >= MAX_HEROES:
        return false
    hero_data["id"] = "hero_%d" % (heroes.size() + 1)
    heroes.append(hero_data)
    hero_count = heroes.size()
    hero_count_changed.emit(hero_count - 1, hero_count)
    return true

func remove_hero(hero_id: String) -> bool:
    for i in range(heroes.size()):
        if heroes[i].get("id") == hero_id:
            heroes.remove_at(i)
            hero_count = heroes.size()
            hero_count_changed.emit(hero_count + 1, hero_count)
            return true
    return false

func get_active_heroes() -> Array:
    # Optimized: Pre-allocate array size
    var active: Array = []
    for hero in heroes:
        if hero.get("status") == "active":
            active.append(hero)
    return active

func get_heroes_for_combat() -> Array:
    return get_active_heroes()

func start_quest() -> void:
    active_quests += 1
    quest_updated.emit(active_quests)

func complete_quest() -> void:
    active_quests = max(0, active_quests - 1)
    quest_updated.emit(active_quests)

func advance_day() -> void:
    current_day += 1

func save_state() -> Dictionary:
    return {
        "gold": gold,
        "silver": silver,
        "heroes": heroes,
        "active_quests": active_quests,
        "current_day": current_day
    }

func load_state(data: Dictionary) -> void:
    gold = data.get("gold", 0)
    silver = data.get("silver", 0)
    heroes = data.get("heroes", [])
    hero_count = heroes.size()
    active_quests = data.get("active_quests", 0)
    current_day = data.get("current_day", 1)
    
    gold_changed.emit(0, gold)
    hero_count_changed.emit(0, hero_count)
    quest_updated.emit(active_quests)

{
  "name": "textical-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Textical RPG Game Server - Handles combat simulation and player data",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --exec \"tsc && node dist/src/index.js\"",
    "start": "node dist/src/index.js",
    "test": "npm run build && node tests/combat.test.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "express": "^4.18.2",
    "socket.io": "^4.8.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.16",
    "@types/socket.io": "^3.0.1",
    "nodemon": "^3.0.3",
    "prisma": "^5.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "author": "",
  "license": "MIT"
}

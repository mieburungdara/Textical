  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, enchantmentId])
}

model GemTemplate {
  id             Int                   @id @default(autoincrement())
  name           String
  element        String
  tier           Int

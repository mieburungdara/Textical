  completions     Int                         @default(0)
  firstEnteredAt  DateTime                    @default(now())
  lastEnteredAt   DateTime                    @default(now())
  completedAt     DateTime?
  lastResetAt     DateTime                    @default(now())
  totalGoldEarned Int                         @default(0)
  totalXpEarned   Int                         @default(0)
  dungeon         DungeonTemplate             @relation(fields: [dungeonId], references: [id])
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  floorProgress   DungeonEntryFloorProgress[]
  rewardsClaimed  DungeonEntryRewardClaim[]

  @@unique([userId, dungeonId])
  @@index([userId])
}

model DungeonEntryFloorProgress {
  id           Int          @id @default(autoincrement())
  entryId      Int
  floorId      Int
  kills        Int          @default(0)
  bossesKilled Int          @default(0)
  entry        DungeonEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, floorId])
}

model DungeonEntryRewardClaim {
  id       Int          @id @default(autoincrement())
  entryId  Int

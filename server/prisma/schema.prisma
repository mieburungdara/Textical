  @@unique([playerAchievId, tierValue])
}

model PlayerTitle {
  id          String    @id @default(uuid())
  userId      Int
  title       String
  icon        String    @default("🎖️")
  badgeColor  String    @default("#ffffff")
  source      String
  sourceCode  String?
  isActive    Boolean   @default(false)
  activatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, title])
  @@index([userId])
}

enum ZoneColor {
  VERDANT
  AZURE
  GOLDEN
  CRIMSON
  OBSIDIAN
  NEUTRAL
}

enum TraversalType {
  WALK
  BOAT
  FLY
}

enum UnitRace {
  HUMAN
  VAMPIRE
  SKELETON
  ZOMBIE
  BEAST
  DEMON
  HUMANOID
  ELEMENTAL
  INSECTOID
  AQUATIC
  DRAGON
  CONSTRUCT
  NEUTRAL
}

enum PvpMode {
  SAFE
  CONSENT
  RESTRICTED
  OPEN
}

enum GameMode {
  DUEL_1V1
  SKIRMISH_2V2
  FREE_FOR_ALL
  TOURNAMENT
}

enum MatchStatus {
  QUEUED
  MATCHING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  TIMEOUT
}

enum WinCondition {

  trait           TraitTemplate   @relation(fields: [traitTemplateId], references: [id])
}

model PrivateIsland {
  id               Int                 @id @default(autoincrement())
  userId           Int                 @unique
  isUnlocked       Boolean             @default(false)
  unlockedAt       DateTime?
  plotCount        Int                 @default(10)
  storageSlotCount Int                 @default(10)
  maxPlots         Int                 @default(50)
  maxStorageSlots  Int                 @default(50)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  plots            GardenPlot[]
  storageItems     IslandStorageItem[]

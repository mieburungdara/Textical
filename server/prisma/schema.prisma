model Faction {
  id              Int                 @id @default(autoincrement())
  version         Int                 @default(1)
  name            String
  description     String
  color           String              @default("#64748b")
  ranks           FactionRank[]
  relationsB      FactionRelation[]   @relation("FactionBRelation")
  relationsA      FactionRelation[]   @relation("FactionARelation")
  alignedGuilds   Guild[]
  npcs            NPCTemplate[]
  quests          QuestTemplate[]
  regions         RegionTemplate[]
  influence       RegionalInfluence[]
  members         User[]
  userReputations UserReputation[]
}

model RegionalInfluence {
  id          Int            @id @default(autoincrement())
  factionId   Int
  regionId    Int
  points      Int            @default(0)
  lastUpdated DateTime       @default(now())
  region      RegionTemplate @relation(fields: [regionId], references: [id])
  faction     Faction        @relation(fields: [factionId], references: [id])

  @@unique([factionId, regionId])
}

model FactionRank {
  id            Int     @id @default(autoincrement())
  factionId     Int
  name          String
  minReputation Int     @default(0)
  statKey       String?
  statValue     Float?
  expBonus      Float?
  faction       Faction @relation(fields: [factionId], references: [id])

  @@unique([factionId, minReputation])
}

model HeroSaleHistory {
  id          Int            @id @default(autoincrement())
  classId     Int
  unitLevel   Int
  price       Int
  regionId    Int
  soldAt      DateTime       @default(now())
  region      RegionTemplate @relation(fields: [regionId], references: [id])
  combatClass ClassTemplate  @relation(fields: [classId], references: [id])
}

model ItemSaleHistory {
  id           Int            @id @default(autoincrement())
  sellerId     Int?
  templateId   Int
  pricePerUnit Int
  quantity     Int
  regionId     Int
  soldAt       DateTime       @default(now())
  region       RegionTemplate @relation(fields: [regionId], references: [id])
  itemTemplate ItemTemplate   @relation(fields: [templateId], references: [id])
  seller       User?          @relation("SellerHistoryRelation", fields: [sellerId], references: [id])
}

model UserReputation {
  id        Int     @id @default(autoincrement())
  userId    Int
  factionId Int
  amount    Int     @default(0)
  faction   Faction @relation(fields: [factionId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, factionId])
}

model DialogueNode {
  id      Int              @id @default(autoincrement())
  version Int              @default(1)
  npcId   Int
  text    String
  isRoot  Boolean          @default(false)
  choices DialogueChoice[]
  npc     NPCTemplate      @relation(fields: [npcId], references: [id])
}

model DialogueChoice {
  id                  Int          @id @default(autoincrement())
  nodeId              Int
  text                String
  nextNodeId          Int?
  questId             Int?
  reputationAmount    Int?
  reputationFactionId Int?
  triggerCombat       Boolean      @default(false)
  node                DialogueNode @relation(fields: [nodeId], references: [id])
}

model Wagon {
  id                      Int           @id @default(autoincrement())
  userId                  Int           @unique
  tier                    String
  capacity                Int           @default(5)
  status                  String        @default("LOADING")
  originRegionId          Int?
  targetRegionId          Int?
  selectedPath            String?
  currentPathIndex        Int           @default(0)
  elapsedTimeInCurrentMap Int           @default(0)
  nextAmbushCheckAt       DateTime?
  feePaid                 Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  lootSessions            LootSession[]
  user                    User          @relation(fields: [userId], references: [id])
  items                   WagonItem[]
}

model WagonItem {
  id         Int          @id @default(autoincrement())
  wagonId    Int
  templateId Int
  quantity   Int          @default(1)
  template   ItemTemplate @relation(fields: [templateId], references: [id])
  wagon      Wagon        @relation(fields: [wagonId], references: [id])
}

model LootSession {
  id        Int      @id @default(autoincrement())
  looterId  Int
  victimId  Int
  wagonId   Int?
  expiresAt DateTime
  isActive  Boolean  @default(true)
  wagon     Wagon?   @relation(fields: [wagonId], references: [id])
  victim    User     @relation("VictimRelation", fields: [victimId], references: [id])
  looter    User     @relation("LooterRelation", fields: [looterId], references: [id])
}

model RegionalExtractionStats {
  id           Int            @id @default(autoincrement())
  regionId     Int
  templateId   Int
  volume24h    Int            @default(0)
  lastUpdated  DateTime       @default(now())
  itemTemplate ItemTemplate   @relation(fields: [templateId], references: [id])
  region       RegionTemplate @relation(fields: [regionId], references: [id])

  @@unique([regionId, templateId])
}

model Bounty {
  id           Int            @id @default(autoincrement())
  targetId     Int
  hunterId     Int?
  rewardSilver BigInt         @default(0)
  status       String         @default("OPEN")
  regionId     Int
  createdAt    DateTime       @default(now())
  claimedAt    DateTime?
  region       RegionTemplate @relation(fields: [regionId], references: [id])
  hunter       User?          @relation("HunterRelation", fields: [hunterId], references: [id])
  target       User           @relation("TargetRelation", fields: [targetId], references: [id])
}

model WorldState {
  id          Int      @id @default(autoincrement())
  currentHour Int      @default(12)
  weatherType String   @default("CLEAR")
  moonPhase   String   @default("NEW")
  lastTick    DateTime @default(now())
}

model ChatMessage {
  id          Int      @id @default(autoincrement())
  channelType String   @default("GLOBAL")
  channelId   Int?
  userId      Int
  message     String
  timestamp   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id])
}

model HeroElementalAffinity {
  id          Int    @id @default(autoincrement())
  heroId      Int
  elementType String
  resistance  Float  @default(0)
  bonusDamage Float  @default(0)
  hero        Hero   @relation(fields: [heroId], references: [id])

  @@unique([heroId, elementType])
}

model EquipmentSetTemplate {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  description String
  setBonuses  EquipmentSetBonus[]
  setPieces   EquipmentSetPiece[]
}

model EquipmentSetPiece {
  id             Int                  @id @default(autoincrement())
  setId          Int
  pieceOrder     Int
  itemTemplateId Int
  set            EquipmentSetTemplate @relation(fields: [setId], references: [id])

  @@unique([setId, pieceOrder])
}

model EquipmentSetBonus {
  id             Int                  @id @default(autoincrement())
  setId          Int
  requiredPieces Int
  description    String
  bonusValue     Int
  bonusStats     String               @default("{}")
  bonusStatRel   EquipmentSetBonusStat[]
  set            EquipmentSetTemplate @relation(fields: [setId], references: [id])

  @@unique([setId, requiredPieces])
}

model SetBonusCondition {
  id             Int    @id @default(autoincrement())
  bonusId        Int
  conditionType  String
  conditionValue String
}

model HeroEquipmentSet {
  id             Int  @id @default(autoincrement())
  heroId         Int
  setId          Int
  equippedPieces Int  @default(0)
  activeBonusId  Int?
  hero           Hero @relation(fields: [heroId], references: [id])

  @@unique([heroId, setId])
}

model StatAllocationTemplate {
  id                 Int    @id @default(autoincrement())
  classId            Int    @unique
  strGrowthCurve     String @default("linear")
  dexGrowthCurve     String @default("linear")
  intGrowthCurve     String @default("linear")
  vitGrowthCurve     String @default("linear")
  lukGrowthCurve     String @default("linear")
  strGrowthFactor    Float  @default(1.0)
  dexGrowthFactor    Float  @default(1.0)
  intGrowthFactor    Float  @default(1.0)
  vitGrowthFactor    Float  @default(1.0)
  lukGrowthFactor    Float  @default(1.0)
  basePointsPerLevel Int    @default(5)
  maxStatCap         Int    @default(255)
  recommendedStr     Int    @default(10)
  recommendedDex     Int    @default(10)
  recommendedInt     Int    @default(10)
  recommendedVit     Int    @default(10)
  recommendedLuk     Int    @default(5)
}

model HeroStatAllocation {
  id              Int       @id @default(autoincrement())
  heroId          Int       @unique
  availablePoints Int       @default(0)
  strAllocated    Int       @default(0)
  dexAllocated    Int       @default(0)
  intAllocated    Int       @default(0)
  vitAllocated    Int       @default(0)
  lukAllocated    Int       @default(0)
  statCaps        String    @default("{}")
  totalSpent      Int       @default(0)
  lastResetAt     DateTime?
  hero            Hero      @relation(fields: [heroId], references: [id])
  caps            HeroStatCap[]
}

model HeroStatHistory {
  id             Int      @id @default(autoincrement())
  heroId         Int
  recordedAt     DateTime @default(now())
  primaryStats   String   @default("{}")
  secondaryStats String   @default("{}")
  level          Int
  equippedItems  String   @default("[]")
  activeBuffs    String   @default("[]")
  hero           Hero     @relation(fields: [heroId], references: [id])
  historyStats   HeroHistoryStat[]
  historyEquip   HeroHistoryEquipment[]
  historyBuffs   HeroHistoryBuff[]

  @@index([heroId, recordedAt])
}

model HeroStatAudit {
  id            Int      @id @default(autoincrement())
  heroId        Int
  recordedAt    DateTime @default(now())
  changeType    String
  statName      String?
  previousValue Float?
  newValue      Float?
  notes         String?
  hero          Hero     @relation(fields: [heroId], references: [id])

  @@index([heroId, recordedAt])
}

model SystemSetting {
  key   String @id
  value String
}

model StatusEffectTemplate {
  id              Int                    @id @default(autoincrement())
  name            String
  type            String
  description     String                 @default("")
  immunities      MonsterImmunity[]
  vulnerabilities MonsterVulnerability[]
}

model MechanicTag {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String       @default("")
  monsters    MonsterTag[]
}

model ReactionTemplate {
  id       Int               @id @default(autoincrement())
  name     String
  script   String
  trigger  String
  cooldown Int               @default(0)
  monsters MonsterReaction[]
}

model AuraTemplate {
  id       Int           @id @default(autoincrement())
  name     String
  radius   Int           @default(1)
  effect   String
  vfxPath  String        @default("")
  monsters MonsterAura[]
}

model SummonTemplate {
  id          Int             @id @default(autoincrement())
  name        String
  spawnUnitId Int
  duration    Int             @default(0)
  statScale   Float           @default(1.0)
  monsters    MonsterSummon[]
  spawnUnit   MonsterTemplate @relation("SummonUnit", fields: [spawnUnitId], references: [id])
}

model EnrageCondition {
  id        Int             @id @default(autoincrement())
  name      String
  trigger   String
  threshold Float           @default(0)
  monsters  MonsterEnrage[]
}

model PhaseTemplate {
  id        Int            @id @default(autoincrement())
  name      String
  trigger   String
  threshold Float          @default(0)
  monsters  MonsterPhase[]
}

model MonsterTag {
  id        Int             @id @default(autoincrement())
  monsterId Int
  tagId     Int
  tag       MechanicTag     @relation(fields: [tagId], references: [id])
  monster   MonsterTemplate @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, tagId])
}

model MonsterSkill {
  id          Int             @id @default(autoincrement())
  monsterId   Int
  skillId     Int
  usageChance Float           @default(1.0)
  cooldown    Int             @default(0)
  priority    Int             @default(0)
  skill       SkillTemplate   @relation(fields: [skillId], references: [id])
  monster     MonsterTemplate @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, skillId])
}

model MonsterReaction {
  id         Int              @id @default(autoincrement())
  monsterId  Int
  reactionId Int
  chance     Float            @default(1.0)
  priority   Int              @default(0)
  reaction   ReactionTemplate @relation(fields: [reactionId], references: [id])
  monster    MonsterTemplate  @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, reactionId])
}

model MonsterAura {
  id        Int             @id @default(autoincrement())
  monsterId Int
  auraId    Int
  level     Int             @default(1)
  aura      AuraTemplate    @relation(fields: [auraId], references: [id])
  monster   MonsterTemplate @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, auraId])
}

model MonsterSummon {
  id        Int             @id @default(autoincrement())
  monsterId Int
  summonId  Int
  chance    Float           @default(1.0)
  maxActive Int             @default(1)
  summon    SummonTemplate  @relation(fields: [summonId], references: [id])
  monster   MonsterTemplate @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, summonId])
}

model MonsterImmunity {
  id             Int                  @id @default(autoincrement())
  monsterId      Int
  statusEffectId Int
  statusEffect   StatusEffectTemplate @relation(fields: [statusEffectId], references: [id])
  monster        MonsterTemplate      @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, statusEffectId])
}

model MonsterVulnerability {
  id             Int                  @id @default(autoincrement())
  monsterId      Int
  statusEffectId Int
  multiplier     Float                @default(1.5)
  statusEffect   StatusEffectTemplate @relation(fields: [statusEffectId], references: [id])
  monster        MonsterTemplate      @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, statusEffectId])
}

model MonsterEnrage {
  id             Int             @id @default(autoincrement())
  monsterId      Int
  enrageId       Int
  stat_hp_bonus  Float           @default(0)
  stat_dmg_bonus Float           @default(0)
  unlockSkillId  Int?
  enrage         EnrageCondition @relation(fields: [enrageId], references: [id])
  monster        MonsterTemplate @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, enrageId])
}

model MonsterCompanion {
  id          Int             @id @default(autoincrement())
  monsterId   Int
  companionId Int
  count       Int             @default(1)
  spawnDelay  Int             @default(0)
  companion   MonsterTemplate @relation("CompanionMonster", fields: [companionId], references: [id])
  monster     MonsterTemplate @relation("ParentMonster", fields: [monsterId], references: [id])

  @@unique([monsterId, companionId])
}

model MonsterPhase {
  id         Int             @id @default(autoincrement())
  monsterId  Int
  phaseId    Int
  phaseOrder Int             @default(1)
  phase      PhaseTemplate   @relation(fields: [phaseId], references: [id])
  monster    MonsterTemplate @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, phaseId])
}

model MonsterFormation {
  id              Int             @id @default(autoincrement())
  monsterId       Int             @unique
  preferredRow    Int             @default(1)
  preferredColumn Int             @default(2)
  monster         MonsterTemplate @relation(fields: [monsterId], references: [id])
}

model MonsterTerritoryBonus {
  id              Int             @id @default(autoincrement())
  monsterId       Int
  regionTypeId    String
  stat_multiplier Float           @default(1.0)
  immune_effect   String?
  bonus_effect    String?
  regionType      RegionType      @relation(fields: [regionTypeId], references: [id])
  monster         MonsterTemplate @relation(fields: [monsterId], references: [id])

  @@unique([monsterId, regionTypeId])
}

model UserSession {
  id            String   @id @default(uuid())
  userId        Int
  deviceId      String
  deviceInfo    String
  deviceType    String   @default("DESKTOP")
  ipAddress     String
  userAgent     String?
  token         String   @unique
  isActive      Boolean  @default(true)
  lastHeartbeat DateTime @default(now())
  createdAt     DateTime @default(now())
  lastActiveAt  DateTime @default(now())
  expiresAt     DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int?
  username  String
  ipAddress String
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
}

model PropertyInstance {
  id              Int                     @id @default(autoincrement())
  userId          Int
  regionId        Int
  propertyName    String?
  tier            Int                     @default(1)
  bulletinMessage String?
  lastRentPaid    DateTime                @default(now())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  guests          PropertyGuest[]
  region          RegionTemplate          @relation(fields: [regionId], references: [id])
  user            User                    @relation(fields: [userId], references: [id])
  recoveryItems   RegionalRecoveryStash[]

  @@unique([userId, regionId])
}

model PropertyGuest {
  id          Int              @id @default(autoincrement())
  propertyId  Int
  guestUserId Int
  permissions String           @default("REST_ONLY")
  createdAt   DateTime         @default(now())
  guest       User             @relation(fields: [guestUserId], references: [id])
  property    PropertyInstance @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, guestUserId])
}

model RegionalRecoveryStash {
  id            Int              @id @default(autoincrement())
  userId        Int
  propertyId    Int
  itemId        Int
  quantity      Int              @default(1)
  recoveryFee   Int              @default(0)
  confiscatedAt DateTime         @default(now())
  item          ItemTemplate     @relation(fields: [itemId], references: [id])
  property      PropertyInstance @relation(fields: [propertyId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
}

enum ZoneColor {

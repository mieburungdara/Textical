  @@unique([userId, profession])
  @@index([userId])
}

model CraftingLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  recipeId    Int
  profession  String
  outcome     String
  itemRarity  String
  successRate Float
  rolled      Float
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model DungeonModifier {
  id              Int                           @id @default(autoincrement())
  modifierKey     String                        @unique
  name            String
  description     String
  category        String
  icon            String                        @default("⚡")
  color           String                        @default("#ff0000")

  nextTier       GemTemplate?          @relation("GemTierUpgrade", fields: [nextTierGemId], references: [id])
  previousTier   GemTemplate?          @relation("GemTierUpgrade")
  sockets        InventoryItemSocket[]

  @@unique([element, tier])
  @@index([element])
  @@index([tier])
}

model InventoryItemSocket {
  id              Int           @id @default(autoincrement())
  inventoryItemId Int           @unique
  gemId           Int?
  insertedAt      DateTime?
  gem             GemTemplate?  @relation(fields: [gemId], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([gemId])
}

model CraftingSkill {
  id           Int      @id @default(autoincrement())
  userId       Int

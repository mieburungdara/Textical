generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                     Int                       @id @default(autoincrement())
  username               String                    @unique
  password               String
  isPvpFlagged           Boolean                   @default(false)
  silver                 Int                       @default(0)
  gold                   Int                       @default(0)
  energy                 Int                       @default(100)
  maxEnergy              Int                       @default(100)
  lastEnergyUpdate       DateTime                  @default(now())
  maxInventorySlots      Int                       @default(20)
  currentRegion          Int                       @default(1)
  tavernTimeSecondsToday Int                       @default(0)
  lastTavernResetAt      DateTime                  @default(now())
  lastQuestResetAt       DateTime                  @default(now())
  tavernEntryAt          DateTime?
  isInTavern             Boolean                   @default(false)
  premiumTierId          Int                       @default(0)
  guildId                Int?
  guildRole              String?
  factionId              Int?
  pvpFlagged             Boolean                   @default(false)
  lastPvpAction          DateTime?
  isKnockedOut           Boolean                   @default(false)
  knockedOutUntil        DateTime?
  recoveryUntil          DateTime?
  lastVisitedCityId      Int?
  settings               UserSetting[]
  moral                  Int                       @default(0)
  bindPointId            Int?
  restingXpPool          Int                       @default(0)
  infamyScore            Int                       @default(0)
  informantReputation    Float                     @default(0.0)
  bountiesAsHunter       Bounty[]                  @relation("HunterRelation")
  bountiesAsTarget       Bounty[]                  @relation("TargetRelation")
  chatMessages           ChatMessage[]
  formationPresets       FormationPreset[]
  gamblingLogs           GamblingLog[]
  targetUserHistory      GuildHistory[]            @relation("TargetUserRelation")
  guildHistory           GuildHistory[]
  createdInvites         GuildInvite[]             @relation("InviterRelation")
  invitedUsers           GuildInvite[]             @relation("InvitedUserRelation")
  heroes                 Hero[]
  heroOrders             HeroOrder[]
  discoveredTreasures    HiddenTreasure[]
  hiredBardEvents        InnBardEvent[]
  guestbookEntries       InnGuestbook[]
  inventory              InventoryItem[]
  salesHistory           ItemSaleHistory[]         @relation("SellerHistoryRelation")
  lootSessionsAsVictim   LootSession[]             @relation("VictimRelation")
  lootSessionsAsLooter   LootSession[]             @relation("LooterRelation")
  receivedMail           Mail[]                    @relation("ReceiverRelation")
  marketOrders           MarketOrder[]
  monsterSpottings       MonsterSpotting[]         @relation("DiscovererRelation")
  monsterStudies         MonsterStudyBuff[]
  notifications          Notification[]
  bountiesIssued         PlayerBounty[]            @relation("BountyIssuer")
  bountiesTargeted       PlayerBounty[]            @relation("BountyTarget")
  dailyTaskProgress      PlayerDailyTaskProgress[]
  guestHouses            PropertyGuest[]
  properties             PropertyInstance[]
  recoveryItems          RegionalRecoveryStash[]
  vaults                 RegionalVault[]
  taskQueue              TaskQueue[]
  rumorsAsSeller         TavernRumor[]             @relation("SellerRumors")
  rumorPurchases         TavernRumorPurchase[]     @relation("BuyerPurchases")
  ledger                 TransactionLedger[]
  bindPoint              RegionTemplate?           @relation("BindPointRelation", fields: [bindPointId], references: [id])
  faction                Faction?                  @relation(fields: [factionId], references: [id])
  guild                  Guild?                    @relation(fields: [guildId], references: [id])
  premiumTier            PremiumTierTemplate       @relation(fields: [premiumTierId], references: [id])
  region                 RegionTemplate            @relation(fields: [currentRegion], references: [id])
  banditReputation       Float                     @default(0.0)
  escortGridsRemaining   Int                       @default(0)
  activeEscortName       String?
  achievements           UserAchievement[]
  friendedBy             UserFriend[]              @relation("FriendedBy")
  friends                UserFriend[]              @relation("UserFriends")
  activeQuests           UserQuest[]
  recipes                UserRecipe[]
  reputation             UserReputation[]
  sessions               UserSession[]
  activeWagon            Wagon?
  killedWorldBosses      WorldBossState[]
  activeSpiritId         Int?
  activeSpiritExpiresAt  DateTime?
  activeSpirit           SpiritTemplate?           @relation("UserActiveSpirit", fields: [activeSpiritId], references: [id])
  attributes             UserAttribute[]
  craftingSkills         CraftingSkill[]
  craftingLogs            CraftingLog[]
  // Private Island
  privateIsland          PrivateIsland?
  // Dynamic Dungeon System
  dungeonEntries         DungeonEntry[]
  // Treasure Map System
  treasureMaps           TreasureMap[]
}

model UserSetting {
  id      Int    @id @default(autoincrement())
  userId  Int
  key     String
  value   String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model WorldBossState {
  id               Int             @id @default(autoincrement())
  monsterId        Int             @unique
  regionId         Int
  isAlive          Boolean         @default(true)
  currentHp        Int             @default(0)
  killedAt         DateTime?
  killedByUserId   Int?
  killedByUserName String?
  updatedAt        DateTime        @updatedAt
  killedByUser     User?           @relation(fields: [killedByUserId], references: [id])
  region           RegionTemplate  @relation(fields: [regionId], references: [id])
  monster          MonsterTemplate @relation(fields: [monsterId], references: [id])
}

model HiddenTreasure {
  id               Int            @id @default(autoincrement())
  regionId         Int
  treasureType     String
  baseChance       Float          @default(0.05)
  lootTableId      String?
  cooldownDays     Int            @default(7)
  lastDiscoveredAt DateTime?
  lastDiscoveredBy Int?
  respawnAt        DateTime?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  user             User?          @relation(fields: [lastDiscoveredBy], references: [id])
  region           RegionTemplate @relation(fields: [regionId], references: [id])
}

model UserFriend {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  friend    User     @relation("FriendedBy", fields: [friendId], references: [id])
  user      User     @relation("UserFriends", fields: [userId], references: [id])

  @@unique([userId, friendId])
}

model AchievementTemplate {
  id          Int               @id @default(autoincrement())
  version     Int               @default(1)
  name        String
  description String
  icon        String            @default("🏆")
  category    String            @default("GENERAL")
  unlockedBy  UserAchievement[]
}

model UserAchievement {
  id            Int                 @id @default(autoincrement())
  userId        Int
  achievementId Int
  unlockedAt    DateTime            @default(now())
  achievement   AchievementTemplate @relation(fields: [achievementId], references: [id])
  user          User                @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
}

model MonsterTemplate {
  id                 Int                     @id @default(autoincrement())
  version            Int                     @default(1)
  name               String
  hp_base            Int
  damage_base        Int
  description        String                  @default("")
  shortDesc          String                  @default("")
  iconPath           String                  @default("")
  modelPath          String                  @default("")
  modelScale         Float                   @default(1.0)
  race               UnitRace                @default(BEAST)
  rank               String                  @default("COMMON")
  size               String                  @default("MEDIUM")
  gridSize           Int                     @default(1)
  movementType       String                  @default("WALK")
  sfx_attack         String?
  sfx_hit            String?
  sfx_die            String?
  dialoguePack       String?
  level              Int                     @default(1)
  xpReward           Int                     @default(10)
  goldReward         Int                     @default(0)
  hp_growth          Float                   @default(0)
  damage_growth      Float                   @default(0)
  defense_growth     Float                   @default(0)
  aiScript           String                  @default("SimpleAI")
  aiConfigs          MonsterAiConfig[]
  attack_element     String                  @default("PHYSICAL")
  threat_modifier    Float                   @default(1.0)
  preferred_target   String                  @default("RANDOM")
  preferred_weather  String?
  active_time        String?
  defense_base       Int                     @default(0)
  speed_base         Int                     @default(5)
  range_base         Int                     @default(1)
  accuracy_base      Int                     @default(100)
  dodge_rate         Float                   @default(0.05)
  crit_chance        Float                   @default(0.05)
  crit_damage        Float                   @default(1.5)
  block_chance       Float                   @default(0)
  block_power_base   Float                   @default(0.5)
  initiative_base    Int                     @default(0)
  lifesteal_base     Float                   @default(0)
  cooldown_reduction Float                   @default(0)
  move_speed         Float                   @default(100)
  attack_speed       Float                   @default(1.0)
  res_fire           Float                   @default(1.0)
  res_water          Float                   @default(1.0)
  res_earth          Float                   @default(1.0)
  res_wind           Float                   @default(1.0)
  res_light          Float                   @default(1.0)
  res_dark           Float                   @default(1.0)
  behaviorTree       String                  @default("SimpleAI")
  categoryId         Int
  eventAppearances   EventMonster[]
  auras              MonsterAura[]
  companionOf        MonsterCompanion[]      @relation("CompanionMonster")
  companions         MonsterCompanion[]      @relation("ParentMonster")
  enrages            MonsterEnrage[]
  formations         MonsterFormation?
  immunities         MonsterImmunity[]
  loot               MonsterLootEntry[]
  phases             MonsterPhase[]
  reactions          MonsterReaction[]
  skills             MonsterSkill[]
  spottings          MonsterSpotting[]
  studies            MonsterStudyBuff[]
  summons            MonsterSummon[]
  tags               MonsterTag[]
  category           MonsterCategory         @relation(fields: [categoryId], references: [id])
  territoryBonuses   MonsterTerritoryBonus[]
  traits             MonsterTrait[]
  vulnerabilities    MonsterVulnerability[]
  regions            RegionMonster[]
  summonSpawns       SummonTemplate[]        @relation("SummonUnit")
  worldBossState     WorldBossState?
  behaviorParams     MonsterBehaviorParam[]
}

model MonsterAiConfig {
  id        Int             @id @default(autoincrement())
  monsterId Int
  key       String
  value     String
  monster   MonsterTemplate @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@unique([monsterId, key])
}

model MonsterTrait {
  id        Int             @id @default(autoincrement())
  monsterId Int
  traitId   Int
  trait     TraitTemplate   @relation(fields: [traitId], references: [id])
  monster   MonsterTemplate @relation(fields: [monsterId], references: [id])
}

model MonsterCategory {
  id       Int               @id @default(autoincrement())
  name     String
  monsters MonsterTemplate[]
}

model MonsterLootEntry {
  id        Int             @id @default(autoincrement())
  monsterId Int
  itemId    Int
  chance    Float
  monster   MonsterTemplate @relation(fields: [monsterId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ItemTemplate {
  id                Int                       @id @default(autoincrement())
  version           Int                       @default(1)
  name              String
  description       String
  category          String                    @default("EQUIPMENT")
  baseValue         Int                       @default(10)
  rarity            String                    @default("COMMON")
  isTwoHanded       Boolean                   @default(false)
  imageUrl          String?
  maxStack          Int                       @default(1)
  isQuestItem       Boolean                   @default(false)
  hardness          Int                       @default(1)
  minStr            Int                       @default(0)
  minToolTier       Int                       @default(0)
  toolTier          Int                       @default(0)
  elementalAffinity Int                       @default(0)
  masteryClassId    Int?
  masteryXpAmount   Int?
  eventAppearances  EventResource[]
  instances         InventoryItem[]
  equipSlots        ItemEquipSlot[]
  saleHistory       ItemSaleHistory[]
  stats             ItemStat[]
  masteryClass      ClassTemplate?            @relation("MasteryTomeRelation", fields: [masteryClassId], references: [id])
  traits            ItemTrait[]
  marketOrders      MarketOrder[]
  shopAppearances   NPCShopItem[]
  ingredients       RecipeIngredient[]
  recipeResult      RecipeTemplate[]
  regionResources   RegionResource[]
  extractionStats   RegionalExtractionStats[]
  recoveryStashes   RegionalRecoveryStash[]
  shopStocks        ShopStock[]
  taskTargets       TaskQueue[]
  wagonItems        WagonItem[]
  weaponTypeId      Int?
  weaponType        WeaponType?            @relation(fields: [weaponTypeId], references: [id])
  historyEquipments HeroHistoryEquipment[]
  // Private Island relations
  cropSeedTemplates     CropTemplate[]         @relation("CropSeed")
  cropHarvestTemplates  CropTemplate[]         @relation("CropHarvest")
  gardenPlotsHarvest    GardenPlot[]           @relation("CropHarvest")
  gardenPlotsSeed      GardenPlot[]           @relation("CropSeed")
  islandStorageItems    IslandStorageItem[]
}

model WeaponType {
  id                Int             @id
  name              String          @unique
  category          String
  items             ItemTemplate[]
  passives          WeaponPassive[]
  tags              WeaponTypeTag[]
}

model WeaponPassive {
  id           Int        @id @default(autoincrement())
  weaponTypeId Int
  name         String
  description  String
  weaponType   WeaponType @relation(fields: [weaponTypeId], references: [id])
}

model WeaponTypeTag {
  id           Int         @id @default(autoincrement())
  weaponTypeId Int
  tagId        Int
  weaponType   WeaponType  @relation(fields: [weaponTypeId], references: [id])
  tag          MechanicTag @relation(fields: [tagId], references: [id])
  @@unique([weaponTypeId, tagId])
}

model InnGuestbook {
  id        Int            @id @default(autoincrement())
  userId    Int
  regionId  Int
  message   String
  createdAt DateTime       @default(now())
  region    RegionTemplate @relation(fields: [regionId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
}

model MonsterSpotting {
  id                 Int             @id @default(autoincrement())
  monsterId          Int
  regionId           Int
  discoveredByUserId Int
  createdAt          DateTime        @default(now())
  expiresAt          DateTime
  discoveredByUser   User            @relation("DiscovererRelation", fields: [discoveredByUserId], references: [id])
  region             RegionTemplate  @relation(fields: [regionId], references: [id])
  monster            MonsterTemplate @relation(fields: [monsterId], references: [id])
}

model MonsterStudyBuff {
  id        Int             @id @default(autoincrement())
  userId    Int
  monsterId Int
  race      UnitRace        @default(HUMAN)
  atkBonus  Float           @default(1.05)
  accBonus  Float           @default(1.05)
  createdAt DateTime        @default(now())
  expiresAt DateTime
  monster   MonsterTemplate @relation(fields: [monsterId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
}

model InnBardEvent {
  id            Int            @id @default(autoincrement())
  regionId      Int
  hiredByUserId Int
  hiredByName   String
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  hiredByUser   User           @relation(fields: [hiredByUserId], references: [id])
  region        RegionTemplate @relation(fields: [regionId], references: [id])
}

model PlayerBounty {
  id           Int      @id @default(autoincrement())
  targetUserId Int
  issuerUserId Int
  rewardAmount Int
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  issuerUser   User     @relation("BountyIssuer", fields: [issuerUserId], references: [id])
  targetUser   User     @relation("BountyTarget", fields: [targetUserId], references: [id])
}

model RegionalVault {
  id       Int            @id @default(autoincrement())
  userId   Int
  regionId Int
  region   RegionTemplate @relation(fields: [regionId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  items    VaultItem[]

  @@unique([userId, regionId])
}

model VaultItem {
  id             Int           @id @default(autoincrement())
  vaultId        Int
  itemInstanceId Int           @unique
  itemInstance   InventoryItem @relation(fields: [itemInstanceId], references: [id])
  vault          RegionalVault @relation(fields: [vaultId], references: [id])
}

model GamblingLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  betAmount Int
  guess     Int
  result    Int
  isWin     Boolean
  payout    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model TavernRumor {
  id            Int                   @id @default(autoincrement())
  sellerId      Int
  regionId      Int
  content       String
  price         Int                   @default(100)
  reliabilityAt Float                 @default(1.0)
  createdAt     DateTime              @default(now())
  region        RegionTemplate        @relation(fields: [regionId], references: [id])
  seller        User                  @relation("SellerRumors", fields: [sellerId], references: [id])
  purchases     TavernRumorPurchase[]
}

model TavernRumorPurchase {
  id          Int         @id @default(autoincrement())
  rumorId     Int
  buyerId     Int
  rating      Int?
  purchasedAt DateTime    @default(now())
  buyer       User        @relation("BuyerPurchases", fields: [buyerId], references: [id])
  rumor       TavernRumor @relation(fields: [rumorId], references: [id])
}

model TavernEvent {
  id             Int             @id @default(autoincrement())
  name           String
  description    String
  type           String
  regionId       Int?
  startsAt       DateTime
  endsAt         DateTime
  buffMultiplier Float           @default(1.5)
  isActive       Boolean         @default(false)
  region         RegionTemplate? @relation(fields: [regionId], references: [id])
}

model RegionalDailyTask {
  id             Int                       @id @default(autoincrement())
  regionId       Int
  title          String
  description    String
  type           String
  targetId       Int
  requiredCount  Int
  silverReward   Int                       @default(500)
  repReward      Int                       @default(10)
  expiresAt      DateTime
  createdAt      DateTime                  @default(now())
  playerProgress PlayerDailyTaskProgress[]
  region         RegionTemplate            @relation(fields: [regionId], references: [id])
}

model PlayerDailyTaskProgress {
  id           Int               @id @default(autoincrement())
  taskId       Int
  userId       Int
  currentCount Int               @default(0)
  status       String            @default("ACCEPTED")
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id])
  task         RegionalDailyTask @relation(fields: [taskId], references: [id])
}

model RegionArea {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  regions     RegionTemplate[]
}

model HazardType {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?
  hazards     RegionHazard[]
}

model RegionHazard {
  id           Int            @id @default(autoincrement())
  regionId     Int
  hazardTypeId Int
  damage       Float          @default(10.0)
  frequencySec Float          @default(5.0)
  hazardType   HazardType     @relation(fields: [hazardTypeId], references: [id])
  region       RegionTemplate @relation(fields: [regionId], references: [id])
}

model RegionTemplate {
  id                     Int                       @id
  version                Int                       @default(1)
  name                   String
  description            String
  visualType             String                    @default("TOWN")
  traversalType          TraversalType             @default(WALK)
  zoneType               String                    @default("GREEN")
  zoneLevel              Int                       @default(1)
  zoneColor              ZoneColor?
  isSafeZone             Boolean                   @default(true)
  regionalTaxRate        Float                     @default(0.10)
  weatherOverride        String?
  specialization         String?
  pvpMode                PvpMode                   @default(SAFE)
  dangerLevel            Int                       @default(1)
  hasInn                 Boolean                   @default(false)
  innTier                Int                       @default(1)
  regionCategory         String?
  isBanditHideout        Boolean                   @default(false)
  monsterMigrationStatus Boolean                   @default(false)
  rareHerbSpawnChance    Float                     @default(0.0)
  mysticFogIntensity     Float                     @default(0.0)
  manaStaticIntensity    Float                     @default(1.0)
  ecologicalStress       Float                     @default(0.0)
  areaId                 Int?
  isDiscoveryPoint       Boolean                   @default(true)
  resourceModifier       Float                     @default(1.0)
  teleportCostMultiplier Float                     @default(1.0)
  maxPartyUnits          Int                       @default(100)
  minimapIcon            String?
  ambientSfxPack         String?
  particleEffectPack     String?
  skyboxOverride         String?
  fogDensity             Float                     @default(0.0)
  gatheringStaminaCost   Float                     @default(1.0)
  mapMusicId             Int?
  regionLoreSnippet      String?
  requiredLevel          Int                       @default(1)
  respawnPenaltyMult     Float                     @default(1.0)
  landmarkName           String?
  flavorText             String?
  discoveryXp            Int                       @default(100)
  spawnRateMultiplier    Float                     @default(1.0)
  eliteSpawnChance       Float                     @default(0.05)
  minRequiredUnits       Int                       @default(0)
  minRequiredHeroLevel   Int                       @default(1)
  requiredAchievementId  Int?
  reputationRequirement  Int                       @default(0)
  factionTributeRate     Float                     @default(0.0)
  elementalAffinity      String                    @default("NEUTRAL")
  terrainAttackMod       Float                     @default(1.0)
  terrainDefenseMod      Float                     @default(1.0)
  innRecoveryRate        Float                     @default(1.0)
  resourceScarcity       Float                     @default(1.0)
  marketDemandIndex      Float                     @default(1.0)
  blessingType           String?
  sanctuaryPower         Float                     @default(0.0)
  plotAvailability       Int                       @default(0)
  rentCostMultiplier     Float                     @default(1.0)
  guildBonusType         String?
  prestigePoints         Int                       @default(0)
  corruptionLevel        Float                     @default(0.0)
  dominanCaste           UnitRace                  @default(NEUTRAL)
  regionTypeId           String?
  factionId              Int?
  guildOwnershipId       Int?
  gridX                  Int                       @default(0)
  gridY                  Int                       @default(0)
  banditThreatLevel      Float                     @default(0.0)
  spiritDensity          Float                     @default(0.0)
  spirits                RegionSpirit[]
  activeEvents           ActiveEvent[]
  bounties               Bounty[]
  heroOrders             HeroOrder[]
  heroSaleHistory        HeroSaleHistory[]
  hiddenTreasures        HiddenTreasure[]
  bardEvents             InnBardEvent[]
  innGuestbook           InnGuestbook[]
  itemSaleHistory        ItemSaleHistory[]
  marketOrders           MarketOrder[]
  monsterSpottings       MonsterSpotting[]
  npcEventReactions      NPCEventReaction[]
  npcSchedules           NPCSchedule[]
  incomingTeleportRoutes NPCTeleportRoute[]
  properties             PropertyInstance[]
  connectedFrom          RegionConnection[]        @relation("TargetRegion")
  connections            RegionConnection[]        @relation("OriginRegion")
  hazards                RegionHazard[]
  monsters               RegionMonster[]
  npcs                   RegionNPC[]
  resources              RegionResource[]
  guildOwnership         Guild?                    @relation("RegionOwnership", fields: [guildOwnershipId], references: [id])
  mapMusic               AudioTrack?               @relation("RegionMusic", fields: [mapMusicId], references: [id])
  faction                Faction?                  @relation(fields: [factionId], references: [id])
  regionType             RegionType?               @relation(fields: [regionTypeId], references: [id])
  area                   RegionArea?               @relation(fields: [areaId], references: [id])
  dailyTasks             RegionalDailyTask[]
  extractionStats        RegionalExtractionStats[]
  influence              RegionalInfluence[]
  regionalVaults         RegionalVault[]
  npcStocks              ShopStock[]
  travelTargets          TaskQueue[]               @relation("TaskTravelTarget")
  travelOrigins          TaskQueue[]               @relation("TaskTravelOrigin")
  tavernEvents           TavernEvent[]
  tavernMercenaries      TavernMercenary[]
  tavernRumors           TavernRumor[]
  territory              Territory?
  boundUsers             User[]                    @relation("BindPointRelation")
  residents              User[]
  worldBosses            WorldBossState[]
}

model AudioTrack {
  id        Int              @id @default(autoincrement())
  name      String
  path      String
  category  String           @default("BGM")
  loops     Boolean          @default(true)
  regions   RegionTemplate[] @relation("RegionMusic")

  @@unique([name, path])
}

model WorldEventTemplate {
  id                 Int                @id @default(autoincrement())
  version            Int                @default(1)
  name               String
  description        String
  combatAtkMult      Float?
  combatDefMult      Float?
  miningYieldMult    Float?
  lumberingYieldMult Float?
  herbalismYieldMult Float?
  fishingYieldMult   Float?
  expGainMult        Float?
  lootChanceMult     Float?
  statIntBonus       Int?
  dangerLevelBonus   Int?
  activeEvents       ActiveEvent[]
  eventMonsters      EventMonster[]
  eventResources     EventResource[]
  npcReactions       NPCEventReaction[]
}

model EventResource {
  id          Int                @id @default(autoincrement())
  templateId  Int
  itemId      Int
  spawnChance Float              @default(1.0)
  gatherTime  Int                @default(10)
  item        ItemTemplate       @relation(fields: [itemId], references: [id])
  template    WorldEventTemplate @relation(fields: [templateId], references: [id])
}

model EventMonster {
  id          Int                @id @default(autoincrement())
  templateId  Int
  monsterId   Int
  spawnChance Float              @default(1.0)
  monster     MonsterTemplate    @relation(fields: [monsterId], references: [id])
  template    WorldEventTemplate @relation(fields: [templateId], references: [id])
}

model ActiveEvent {
  id         Int                @id @default(autoincrement())
  templateId Int
  regionId   Int
  startedAt  DateTime           @default(now())
  expiresAt  DateTime
  region     RegionTemplate     @relation(fields: [regionId], references: [id])
  template   WorldEventTemplate @relation(fields: [templateId], references: [id])

  @@unique([regionId, templateId])
}

model RegionNPC {
  id          Int            @id @default(autoincrement())
  regionId    Int
  npcId       Int
  spawnChance Float          @default(1.0)
  isTemporary Boolean        @default(false)
  expiresAt   DateTime?
  npc         NPCTemplate    @relation(fields: [npcId], references: [id])
  region      RegionTemplate @relation(fields: [regionId], references: [id])

  @@unique([regionId, npcId])
}

model NPCTemplate {
  id             Int                @id @default(autoincrement())
  version        Int                @default(1)
  name           String
  title          String
  description    String
  type           String
  isWanderer     Boolean            @default(false)
  healCost       Int?
  betMultiplier  Float?
  betWinChance   Float?
  travelCost     Int?
  factionId      Int?
  active_time    String?
  dialogueNodes  DialogueNode[]
  eventReactions NPCEventReaction[]
  schedules      NPCSchedule[]
  shopItems      NPCShopItem[]
  teleportRoutes NPCTeleportRoute[]
  faction        Faction?           @relation(fields: [factionId], references: [id])
  questsTurnedIn QuestTemplate[]    @relation("QuestTurnInRelation")
  questsGiven    QuestTemplate[]    @relation("QuestGiverRelation")
  regions        RegionNPC[]
  currentStock   ShopStock[]
}

model ShopStock {
  id           Int            @id @default(autoincrement())
  npcId        Int
  regionId     Int
  templateId   Int
  quantity     Int            @default(0)
  maxQuantity  Int            @default(50)
  nextRestock  DateTime
  itemTemplate ItemTemplate   @relation(fields: [templateId], references: [id])
  region       RegionTemplate @relation(fields: [regionId], references: [id])
  npc          NPCTemplate    @relation(fields: [npcId], references: [id])

  @@unique([npcId, regionId, templateId])
}

model NPCSchedule {
  id             Int            @id @default(autoincrement())
  npcId          Int
  hourStart      Int
  hourEnd        Int
  targetRegionId Int
  targetRegion   RegionTemplate @relation(fields: [targetRegionId], references: [id])
  npc            NPCTemplate    @relation(fields: [npcId], references: [id])
}

model NPCEventReaction {
  id                 Int                @id @default(autoincrement())
  npcId              Int
  eventTemplateId    Int
  actionType         String
  targetRegionId     Int?
  overrideDialogueId Int?
  targetRegion       RegionTemplate?    @relation(fields: [targetRegionId], references: [id])
  eventTemplate      WorldEventTemplate @relation(fields: [eventTemplateId], references: [id])
  npc                NPCTemplate        @relation(fields: [npcId], references: [id])
}

model NPCTeleportRoute {
  id             Int            @id @default(autoincrement())
  npcId          Int
  targetRegionId Int
  targetRegion   RegionTemplate @relation(fields: [targetRegionId], references: [id])
  npc            NPCTemplate    @relation(fields: [npcId], references: [id])

  @@unique([npcId, targetRegionId])
}

model NPCShopItem {
  id        Int          @id @default(autoincrement())
  npcId     Int
  itemId    Int
  priceGold Int
  stock     Int          @default(-1)
  item      ItemTemplate @relation(fields: [itemId], references: [id])
  npc       NPCTemplate  @relation(fields: [npcId], references: [id])
}

model RegionMonster {
  id        Int             @id @default(autoincrement())
  regionId  Int
  monsterId Int
  monster   MonsterTemplate @relation(fields: [monsterId], references: [id])
  region    RegionTemplate  @relation(fields: [regionId], references: [id])

  @@index([regionId])
}

model RegionType {
  id                      String                  @id
  name                    String
  description             String?
  monsterTerritoryBonuses MonsterTerritoryBonus[]
  regions                 RegionTemplate[]
  effects                 TerrainEffect[]
}

model TerrainEffect {
  id           Int        @id @default(autoincrement())
  regionTypeId String
  effectType   String
  chance       Float      @default(1.0)
  power        Float      @default(0)
  statKey      String?
  statValue    Float?
  tickInterval Int        @default(1)
  regionType   RegionType @relation(fields: [regionTypeId], references: [id])
}

model TavernMercenary {
  id              Int            @id @default(autoincrement())
  heroId          Int            @unique
  regionId        Int
  recruitmentCost Int            @default(100)
  expiresAt       DateTime
  region          RegionTemplate @relation(fields: [regionId], references: [id])
  hero            Hero           @relation(fields: [heroId], references: [id])

  @@index([regionId, expiresAt])
}

model RegionConnection {
  id                Int            @id @default(autoincrement())
  originRegionId    Int
  targetRegionId    Int
  travelTimeSeconds Int            @default(15)
  target            RegionTemplate @relation("TargetRegion", fields: [targetRegionId], references: [id])
  origin            RegionTemplate @relation("OriginRegion", fields: [originRegionId], references: [id])

  @@unique([originRegionId, targetRegionId])
}

model RegionResource {
  id                Int            @id @default(autoincrement())
  regionId          Int
  itemId            Int
  gatherTimeSeconds Int            @default(10)
  active_time       String?
  item              ItemTemplate   @relation(fields: [itemId], references: [id])
  region            RegionTemplate @relation(fields: [regionId], references: [id])
}

model ItemTrait {
  id      Int           @id @default(autoincrement())
  itemId  Int
  traitId Int
  trait   TraitTemplate @relation(fields: [traitId], references: [id])
  item    ItemTemplate  @relation(fields: [itemId], references: [id])
}

model TraitTemplate {
  id            Int                 @id @default(autoincrement())
  name          String
  description   String              @default("")
  category      String              @default("GENERAL")
  heroes        HeroTrait[]
  instanceItems ItemInstanceTrait[]
  items         ItemTrait[]
  monsters      MonsterTrait[]
  historyBuffs  HeroHistoryBuff[]
  stats         TraitStat[]
}

model TraitStat {
  id        Int           @id @default(autoincrement())
  traitId   Int
  statKey   String
  statValue Float
  trait     TraitTemplate @relation(fields: [traitId], references: [id])
}

model ItemEquipSlot {
  id      Int          @id @default(autoincrement())
  itemId  Int
  slotKey String
  item    ItemTemplate @relation(fields: [itemId], references: [id])
}

model ItemStat {
  id        Int          @id @default(autoincrement())
  itemId    Int
  statKey   String
  statValue Float
  item      ItemTemplate @relation(fields: [itemId], references: [id])
}

model RecipeTemplate {
  id               Int                @id @default(autoincrement())
  version          Int                @default(1)
  name             String
  description      String
  resultItemId     Int
  craftTimeSeconds Int                @default(30)
  ingredients      RecipeIngredient[]
  resultItem       ItemTemplate       @relation(fields: [resultItemId], references: [id])
  learnedBy        UserRecipe[]
}

model RecipeIngredient {
  id       Int            @id @default(autoincrement())
  recipeId Int
  itemId   Int
  quantity Int
  item     ItemTemplate   @relation(fields: [itemId], references: [id])
  recipe   RecipeTemplate @relation(fields: [recipeId], references: [id])
}

model UserRecipe {
  id       Int            @id @default(autoincrement())
  userId   Int
  recipeId Int
  recipe   RecipeTemplate @relation(fields: [recipeId], references: [id])
  user     User           @relation(fields: [userId], references: [id])

  @@unique([userId, recipeId])
}

model Hero {
  id                  Int                     @id @default(autoincrement())
  userId              Int
  name                String
  race                UnitRace                @default(HUMAN)
  unitLevel           Int                     @default(1)
  unitXp              Int                     @default(0)
  classLevel          Int                     @default(1)
  classXp             Int                     @default(0)
  level               Int                     @default(1)
  xp                  Int                     @default(0)
  hp_base             Int                     @default(100)
  damage_base         Int                     @default(10)
  str                 Int                     @default(10)
  dex                 Int                     @default(10)
  int                 Int                     @default(10)
  def                 Int                     @default(10)
  fire_damage         Int                     @default(0)
  water_damage        Int                     @default(0)
  earth_damage        Int                     @default(0)
  wind_damage         Int                     @default(0)
  light_damage        Int                     @default(0)
  dark_damage         Int                     @default(0)
  defense_base        Int                     @default(0)
  speed_base          Int                     @default(5)
  range_base          Int                     @default(1)
  dodge_chance        Float                   @default(0.05)
  crit_chance         Float                   @default(0.05)
  crit_damage         Float                   @default(1.5)
  block_chance        Float                   @default(0)
  parry_chance        Float                   @default(0)
  hp_regen            Float                   @default(0)
  mana_regen          Float                   @default(2)
  accuracy_base       Int                     @default(100)
  armor_penetration   Int                     @default(0)
  skill_power_base    Int                     @default(10)
  tenacity_base       Float                   @default(0)
  block_power_base    Float                   @default(0.5)
  initiative_base     Int                     @default(0)
  lifesteal_base      Float                   @default(0)
  spell_vamp          Float                   @default(0)
  cooldown_reduction  Float                   @default(0)
  move_speed          Float                   @default(100)
  attack_speed        Float                   @default(1.0)
  classId             Int
  jobId               Int?
  vitality            Int                     @default(100)
  isMain              Boolean                 @default(false)
  generation          Int                     @default(1)
  hasOffspring        Boolean                 @default(false)
  fatherId            Int?
  motherId            Int?
  formationSlots      FormationSlot[]
  mother              Hero?                   @relation("MotherRelation", fields: [motherId], references: [id])
  childrenOfMother    Hero[]                  @relation("MotherRelation")
  father              Hero?                   @relation("FatherRelation", fields: [fatherId], references: [id])
  childrenOfFather    Hero[]                  @relation("FatherRelation")
  job                 JobTemplate?            @relation(fields: [jobId], references: [id])
  combatClass         ClassTemplate           @relation(fields: [classId], references: [id])
  user                User?                   @relation(fields: [userId], references: [id])
  buffs               HeroBuff[]
  mastery             HeroClassMastery[]
  elementalAffinities HeroElementalAffinity[]
  equipment           HeroEquipment[]
  equipmentSets       HeroEquipmentSet[]
  heroOrders          HeroOrder?
  skills              HeroSkill[]
  statAudits          HeroStatAudit[]
  statHistory         HeroStatHistory[]
  traits              HeroTrait[]
  taskQueue           TaskQueue[]
  tavernEntry         TavernMercenary?

  @@index([userId])
}

model HeroOrder {
  id            Int            @id @default(autoincrement())
  creatorId     Int
  regionId      Int
  type          String
  price         Int
  heroId        Int?           @unique
  targetClassId Int?
  minUnitLevel  Int            @default(1)
  status        String         @default("OPEN")
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  targetClass   ClassTemplate? @relation(fields: [targetClassId], references: [id])
  hero          Hero?          @relation(fields: [heroId], references: [id])
  region        RegionTemplate @relation(fields: [regionId], references: [id])
  creator       User           @relation(fields: [creatorId], references: [id])
}

model SkillTemplate {
  id            Int              @id @default(autoincrement())
  version       Int              @default(1)
  name          String
  description   String
  category      String
  type          String
  statKey       String?
  statValue     Float?
  power         Float?
  duration      Int?
  multiplier    Float?
  manaCost      Int              @default(0)
  classTrees    ClassSkillTree[]
  heroSkills    HeroSkill[]
  monsterSkills MonsterSkill[]
}

model ClassSkillTree {
  id          Int           @id @default(autoincrement())
  classId     Int
  skillId     Int
  unlockLevel Int           @default(1)
  skill       SkillTemplate @relation(fields: [skillId], references: [id])
  class       ClassTemplate @relation(fields: [classId], references: [id])

  @@unique([classId, skillId])
}

model HeroSkill {
  id         Int           @id @default(autoincrement())
  heroId     Int
  skillId    Int
  unlockedAt DateTime      @default(now())
  isActive   Boolean       @default(true)
  skill      SkillTemplate @relation(fields: [skillId], references: [id])
  hero       Hero          @relation(fields: [heroId], references: [id])

  @@unique([heroId, skillId])
}

model HeroClassMastery {
  id         Int           @id @default(autoincrement())
  heroId     Int
  classId    Int
  level      Int           @default(1)
  xp         Int           @default(0)
  isMastered Boolean       @default(false)
  class      ClassTemplate @relation(fields: [classId], references: [id])
  hero       Hero          @relation(fields: [heroId], references: [id])

  @@unique([heroId, classId])
}

model HeroBuff {
  id        Int      @id @default(autoincrement())
  heroId    Int
  itemId    Int?
  name      String
  statKey   String
  statValue Float
  isPercent Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  hero      Hero     @relation(fields: [heroId], references: [id])
}

model ClassTemplate {
  id                Int                @id @default(autoincrement())
  version           Int                @default(1)
  name              String
  tier              Int                @default(1)
  resourceType      String             @default("MANA")
  focus             String             @default("General")
  identity          String             @default("A versatile starting point.")
  description       String             @default("")
  growthDesc        String             @default("Balanced growth across all stats.")
  mechanicDesc      String             @default("Uses standard Mana.")
  hpGrowth          Float              @default(5)
  mpGrowth          Float              @default(2)
  atkGrowth         Float              @default(1)
  defGrowth         Float              @default(0.5)
  spdGrowth         Float              @default(0.1)
  promotionReqLevel Int                @default(20)
  parentClassId     Int?
  skills            ClassSkillTree[]
  parentClass       ClassTemplate?     @relation("ClassEvolution", fields: [parentClassId], references: [id])
  childClasses      ClassTemplate[]    @relation("ClassEvolution")
  heroes            Hero[]
  mastery           HeroClassMastery[]
  heroBuyOrders     HeroOrder[]
  heroSaleHistory   HeroSaleHistory[]
  masteryTomes      ItemTemplate[]     @relation("MasteryTomeRelation")
}

model JobTemplate {
  id       Int    @id @default(autoincrement())
  name     String
  category String @default("COLLECTION")
  workers  Hero[]
}

model TaskQueue {
  id              Int             @id @default(autoincrement())
  userId          Int
  heroId          Int?
  type            String
  targetItemId    Int?
  originRegionId  Int?
  targetRegionId  Int?
  status          String          @default("PENDING")
  startedAt       DateTime?
  finishesAt      DateTime?
  affixMaterialId Int?
  targetRegion    RegionTemplate? @relation("TaskTravelTarget", fields: [targetRegionId], references: [id])
  originRegion    RegionTemplate? @relation("TaskTravelOrigin", fields: [originRegionId], references: [id])
  targetItem      ItemTemplate?   @relation(fields: [targetItemId], references: [id])
  hero            Hero?           @relation(fields: [heroId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([heroId])
}

model FormationPreset {
  id     Int             @id @default(autoincrement())
  userId Int
  name   String
  user   User            @relation(fields: [userId], references: [id])
  slots  FormationSlot[]
}

model FormationSlot {
  id       Int             @id @default(autoincrement())
  presetId Int
  heroId   Int
  gridX    Int
  gridY    Int
  hero     Hero            @relation(fields: [heroId], references: [id])
  preset   FormationPreset @relation(fields: [presetId], references: [id])

  @@unique([presetId, gridX, gridY])
  @@unique([presetId, heroId])
}

model HeroEquipment {
  id             Int           @id @default(autoincrement())
  heroId         Int
  slotKey        String
  itemInstanceId Int           @unique
  itemInstance   InventoryItem @relation(fields: [itemInstanceId], references: [id])
  hero           Hero          @relation(fields: [heroId], references: [id])

  @@unique([heroId, slotKey])
}

model InventoryItem {
  id                Int                 @id @default(autoincrement())
  userId            Int
  templateId        Int
  quantity          Int                 @default(1)
  currentDurability Int                 @default(100)
  maxDurability     Int                 @default(100)
  isTrash           Boolean             @default(false)
  isCursed          Boolean             @default(false)
  quality           String              @default("COMMON")
  powerScale        Float               @default(1.0)
  isSoulbound       Boolean             @default(false)
  isStolen          Boolean             @default(false)
  equippedIn        HeroEquipment?
  template          ItemTemplate        @relation(fields: [templateId], references: [id])
  user              User                @relation(fields: [userId], references: [id])
  instanceTraits    ItemInstanceTrait[]
  historyEquipments HeroHistoryEquipment[]
  marketOrders      MarketOrder[]
  vaultItem         VaultItem?
  enchantments      InventoryItemEnchantment[]
  socket            InventoryItemSocket?

  @@index([userId])
  @@index([userId, templateId])
}

model ItemInstanceTrait {
  id             Int           @id @default(autoincrement())
  itemInstanceId Int
  traitId        Int
  trait          TraitTemplate @relation(fields: [traitId], references: [id])
  itemInstance   InventoryItem @relation(fields: [itemInstanceId], references: [id])
}

model MarketOrder {
  id                Int            @id @default(autoincrement())
  creatorId         Int
  regionId          Int
  templateId        Int
  type              String
  pricePerUnit      Int
  initialQuantity   Int
  remainingQuantity Int
  itemInstanceId    Int?
  status            String         @default("OPEN")
  expiresAt         DateTime
  createdAt         DateTime       @default(now())
  itemInstance      InventoryItem? @relation(fields: [itemInstanceId], references: [id])
  itemTemplate      ItemTemplate   @relation(fields: [templateId], references: [id])
  region            RegionTemplate @relation(fields: [regionId], references: [id])
  creator           User           @relation(fields: [creatorId], references: [id])

  @@index([templateId, status])
  @@index([expiresAt])
  @@index([creatorId])
}

model QuestTemplate {
  id            Int          @id @default(autoincrement())
  version       Int          @default(1)
  name          String
  description   String
  category      String       @default("MAIN")
  minReputation Int          @default(0)
  factionId     Int?
  questGiverId  Int?
  turnInNpcId   Int?
  isDynamic     Boolean      @default(false)
  expiresAt     DateTime?
  stages        QuestStage[]
  turnInNpc     NPCTemplate? @relation("QuestTurnInRelation", fields: [turnInNpcId], references: [id])
  questGiver    NPCTemplate? @relation("QuestGiverRelation", fields: [questGiverId], references: [id])
  faction       Faction?     @relation(fields: [factionId], references: [id])
  userQuests    UserQuest[]
}

model QuestStage {
  id          Int              @id @default(autoincrement())
  questId     Int
  order       Int              @default(1)
  name        String
  description String
  objectives  QuestObjective[]
  rewards     QuestReward[]
  quest       QuestTemplate    @relation(fields: [questId], references: [id])
  userQuests  UserQuest[]      @relation("CurrentStageRelation")

  @@unique([questId, order])
}

model QuestObjective {
  id          Int        @id @default(autoincrement())
  stageId     Int
  type        String
  targetId    Int
  amount      Int        @default(1)
  description String
  stage       QuestStage @relation(fields: [stageId], references: [id])
}

model QuestReward {
  id        Int        @id @default(autoincrement())
  stageId   Int
  type      String
  itemId    Int?
  amount    Int        @default(1)
  factionId Int?
  stage     QuestStage @relation(fields: [stageId], references: [id])
}

model UserQuest {
  id             Int           @id @default(autoincrement())
  userId         Int
  questId        Int
  currentStageId Int?
  status         String        @default("ACTIVE")
  progressData   UserQuestProgress[]
  currentStage   QuestStage?   @relation("CurrentStageRelation", fields: [currentStageId], references: [id])
  quest          QuestTemplate @relation(fields: [questId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  variables      UserQuestVariable[]

  @@index([userId, status])
  @@index([questId])
}

model UserQuestProgress {
  id          Int       @id @default(autoincrement())
  userQuestId Int
  key         String
  value       String
  userQuest   UserQuest @relation(fields: [userQuestId], references: [id], onDelete: Cascade)

  @@unique([userQuestId, key])
}

model Mail {
  id         Int      @id @default(autoincrement())
  receiverId Int
  subject    String
  content    String   @default("")
  silver     Int      @default(0)
  gold       Int      @default(0)
  expiresAt  DateTime
  isClaimed  Boolean  @default(false)
  isRead     Boolean  @default(false)
  receiver   User     @relation("ReceiverRelation", fields: [receiverId], references: [id])
}

model HeroTrait {
  id      Int           @id @default(autoincrement())
  heroId  Int
  traitId Int
  trait   TraitTemplate @relation(fields: [traitId], references: [id])
  hero    Hero          @relation(fields: [heroId], references: [id])
}

model Guild {
  id               Int              @id @default(autoincrement())
  name             String           @unique
  templateId       Int
  color            String           @default("#f59e0b")
  vaultGold        Int              @default(0)
  treasury         Int              @default(0)
  marketTaxRate    Float            @default(0.0)
  gatheringTaxRate Float            @default(0.0)
  factionId        Int?
  faction          Faction?         @relation(fields: [factionId], references: [id])
  template         GuildTemplate    @relation(fields: [templateId], references: [id])
  facilities       GuildFacility[]
  history          GuildHistory[]
  invites          GuildInvite[]
  perks            GuildPerk[]
  ownedRegions     RegionTemplate[] @relation("RegionOwnership")
  siegesAsAttacker Siege[]          @relation("AttackerRelation")
  territories      Territory[]
  Members          User[]
}

model GuildHistoryMetadata {
  id        Int          @id @default(autoincrement())
  historyId Int
  key       String
  value     String
  history   GuildHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@unique([historyId, key])
}

model GuildInvite {
  id            Int      @id @default(autoincrement())
  guildId       Int
  invitedUserId Int?
  invitedBy     Int
  inviteCode    String   @unique
  status        String   @default("PENDING")
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  inviter       User     @relation("InviterRelation", fields: [invitedBy], references: [id])
  invitedUser   User?    @relation("InvitedUserRelation", fields: [invitedUserId], references: [id])
  guild         Guild    @relation(fields: [guildId], references: [id])

  @@index([guildId])
  @@index([inviteCode])
}

model GuildHistory {
  id           Int      @id @default(autoincrement())
  guildId      Int
  eventType    String
  userId       Int?
  targetUserId Int?
  description  String
  metadata     GuildHistoryMetadata[]
  createdAt    DateTime @default(now())
  targetUser   User?    @relation("TargetUserRelation", fields: [targetUserId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])
  guild        Guild    @relation(fields: [guildId], references: [id])
  metadataRel  GuildHistoryMeta[]

  @@index([guildId])
  @@index([createdAt])
}

model FactionRelation {
  id         Int     @id @default(autoincrement())
  factionAId Int
  factionBId Int
  status     String  @default("NEUTRAL")
  factionB   Faction @relation("FactionBRelation", fields: [factionBId], references: [id])
  factionA   Faction @relation("FactionARelation", fields: [factionAId], references: [id])

  @@unique([factionAId, factionBId])
}

model Territory {
  id                   Int            @id @default(autoincrement())
  regionId             Int            @unique
  guildId              Int
  fortification        Int            @default(1000)
  maxFortification     Int            @default(1000)
  siegeStatus          String         @default("PEACE")
  capturedAt           DateTime       @default(now())
  lastUpkeepAt         DateTime       @default(now())

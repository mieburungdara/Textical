  VAMPIRE
  SKELETON
  ZOMBIE
  BEAST
  DEMON
  HUMANOID
  ELEMENTAL
  INSECTOID
  AQUATIC
  DRAGON
  CONSTRUCT
  NEUTRAL
}

enum PvpMode {
  SAFE
  CONSENT
  RESTRICTED
  OPEN
}

model SpiritTemplate {

  isClaimed       Boolean   @default(false)
  usedAt          DateTime?
  claimedAt       DateTime?
  expiresAt       DateTime
  coordOffsetX    Int       @default(0)
  coordOffsetY    Int       @default(0)
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, rarity])
  @@index([expiresAt])
}

model TreasureLootTable {
  id              Int     @id @default(autoincrement())
  rarity          String
  lootType        String
  goldMin         Int?
  goldMax         Int?
  goldWeight      Int?
  itemTemplateId  Int?
  quantityMin     Int?
  quantityMax     Int?
  itemWeight      Int?
  dropChance      Float   @default(1.0)
  isEpicItem      Boolean @default(false)
  isLegendaryItem Boolean @default(false)
  itemRarity      String?

  @@unique([rarity, lootType, itemTemplateId])
  @@index([rarity])
}

model ArenaMatch {
  id           String                  @id @default(uuid())
  matchCode    String                  @unique
  gameMode     GameMode
  status       MatchStatus             @default(QUEUED)
  winnerId     String?
  winCondition WinCondition?
  queuedAt     DateTime                @default(now())
  startedAt    DateTime?
  endedAt      DateTime?
  duration     Int?
  seasonId     String?
  isRanked     Boolean                 @default(true)
  battleId     String?
  participants ArenaMatchParticipant[]

  @@index([seasonId, gameMode])
  @@index([status])
  @@index([winnerId])
}

model ArenaMatchParticipant {
  id           String     @id @default(uuid())
  matchId      String
  playerId     String
  teamId       String?
  score        Int        @default(0)
  ratingBefore Int?
  ratingAfter  Int?
  ratingDelta  Int?
  match        ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model ArenaRating {
  playerId      String   @id
  seasonId      String
  soloRating    Int      @default(1000)
  soloWins      Int      @default(0)
  soloLosses    Int      @default(0)
  soloStreak    Int      @default(0)
  teamRating    Int      @default(1000)
  teamWins      Int      @default(0)
  teamLosses    Int      @default(0)
  ffaPoints     Int      @default(0)
  ffaWins       Int      @default(0)
  ffaPlays      Int      @default(0)
  currentRank   String   @default("Bronze V")
  highestRank   String   @default("Bronze V")
  division      Int      @default(5)
  seasonWins    Int      @default(0)
  seasonMatches Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([playerId, seasonId])
}

model ArenaSeason {
  id            String                 @id @default(uuid())
  seasonNumber  Int                    @unique
  name          String
  startDate     DateTime
  endDate       DateTime
  participation Int                    @default(0)
  isActive      Boolean                @default(false)
  isComplete    Boolean                @default(false)
  createdAt     DateTime               @default(now())
  topRewards    ArenaSeasonTopReward[]
}

model ArenaSeasonTopReward {
  id        Int         @id @default(autoincrement())
  seasonId  String
  rankValue Int
  gems      Int         @default(0)
  title     String?
  season    ArenaSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, rankValue])
}

model ArenaLeaderboard {
  id             String   @id @default(uuid())
  playerId       String
  seasonId       String
  gameMode       GameMode
  rank           Int
  rating         Int
  wins           Int
  losses         Int
  winRate        Float
  currentStreak  Int      @default(0)
  maxStreak      Int      @default(0)
  spectatedCount Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([playerId, seasonId, gameMode])
  @@index([seasonId, gameMode, rank])
}

model Tournament {
  id                  String                  @id @default(uuid())
  name                String
  type                TournamentType
  maxParticipants     Int
  currentParticipants Int                     @default(0)
  bracketType         BracketType
  registrationStart   DateTime
  registrationEnd     DateTime
  startDate           DateTime
  endDate             DateTime
  entryFee            Int
  minLevel            Int                     @default(50)
  participationReward Int                     @default(0)
  status              TournamentStatus        @default(REGISTRATION)
  winnerId            String?
  createdAt           DateTime                @default(now())
  bracket             TournamentBracket?
  matches             TournamentMatch[]
  participants        TournamentParticipant[]
  prizePool           TournamentPrize[]

  @@index([status, startDate])
}

model TournamentPrize {
  id           Int        @id @default(autoincrement())
  tournamentId String
  rankValue    Int
  gems         Int        @default(0)
  title        String?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, rankValue])
}

model TournamentParticipant {
  id              String            @id @default(uuid())
  tournamentId    String
  playerId        String
  seed            Int
  elo             Int
  status          ParticipantStatus @default(REGISTERED)
  checkedIn       Boolean           @default(false)
  currentRound    Int               @default(0)
  wins            Int               @default(0)
  losses          Int               @default(0)
  isEliminated    Boolean           @default(false)
  bracketPosition Int
  createdAt       DateTime          @default(now())
  tournament      Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([tournamentId, seed])
}

model TournamentMatch {
  id               String      @id @default(uuid())
  tournamentId     String
  round            Int
  matchNumber      Int
  bracketType      BracketType @default(SINGLE_ELIMINATION)
  playerAId        String?
  playerBId        String?
  winnerId         String?
  scoreA           Int         @default(0)
  scoreB           Int         @default(0)
  scheduledAt      DateTime
  startedAt        DateTime?
  completedAt      DateTime?
  arenaMatchId     String?
  nextMatchId      String?
  loserNextMatchId String?
  status           MatchStatus @default(QUEUED)
  tournament       Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, round])
  @@index([status])
}

model TournamentBracket {
  id            String     @id @default(uuid())
  tournamentId  String     @unique
  bracketData   String
  currentRound  Int
  activeMatches String
  updatedAt     DateTime   @updatedAt
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Achievement {
  id              String              @id @default(uuid())
  code            String              @unique
  name            String
  description     String
  category        AchievementCategory
  icon            String              @default("🏆")
  requirementType String
  targetValue     Int
  counterName     String
  isProgressive   Boolean             @default(false)
  tiers           String?
  rewardGold      Int                 @default(0)
  rewardGems      Int                 @default(0)
  rewardItems     String?
  rewardTitle     String?
  isHidden        Boolean             @default(false)
  hiddenCondition String?
  prereqCode      String?
  minLevel        Int                 @default(1)
  isActive        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  playerProgress  PlayerAchievement[]

  @@index([category, isActive])
  @@index([counterName])
}

model PlayerAchievement {
  id              String                  @id @default(uuid())
  userId          Int
  achievementCode String
  currentValue    Int                     @default(0)
  isCompleted     Boolean                 @default(false)
  completedAt     DateTime?
  currentTier     Int                     @default(0)
  rewardsClaimed  Boolean                 @default(false)
  claimedAt       DateTime?
  isDiscovered    Boolean                 @default(false)
  discoveredAt    DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  achievement     Achievement             @relation(fields: [achievementCode], references: [code])
  unlockedTiers   PlayerAchievementTier[]

  @@unique([userId, achievementCode])
  @@index([userId])
}

model PlayerAchievementTier {
  id                Int               @id @default(autoincrement())
  playerAchievId    String
  tierValue         Int

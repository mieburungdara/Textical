  templateId Int
  key        String
  valStr     String?
  valInt     Int?
  valFloat   Float?
  valBool    Boolean?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  template   GuildTemplate @relation(fields: [templateId], references: [id])


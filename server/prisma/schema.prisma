  @@index([heroId])
}

model SkillMasteryReward {
  id                  Int    @id @default(autoincrement())
  level               String
  usesRequired        Int
  skillDamageBonus    Float  @default(0)
  effectDurationBonus Float  @default(0)
  critChanceBonus     Float  @default(0)
  costReduction       Float  @default(0)
  description         String @default("")
}

model HeroBond {
  id          Int     @id @default(autoincrement())
  bondType    String
  name        String  @unique
  description String
  requirement String
  bonuses     String

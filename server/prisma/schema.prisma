  expiresAt     DateTime?
  stages        QuestStage[]
  faction       Faction?     @relation(fields: [factionId], references: [id])
  questGiver    NPCTemplate? @relation("QuestGiverRelation", fields: [questGiverId], references: [id])
  turnInNpc     NPCTemplate? @relation("QuestTurnInRelation", fields: [turnInNpcId], references: [id])

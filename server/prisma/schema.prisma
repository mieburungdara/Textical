  @@unique([floorId, monsterId])
}

model DungeonFloorModifier {
  id         Int             @id @default(autoincrement())
  floorId    Int
  modifierId Int
  stackCount Int             @default(1)
  floor      DungeonFloor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  modifier   DungeonModifier @relation(fields: [modifierId], references: [id])

  @@unique([floorId, modifierId])
}

model DungeonEntry {
  id              Int                         @id @default(autoincrement())
  userId          Int
  dungeonId       Int

}

model HeroHistoryStat {
  id        Int              @id @default(autoincrement())
  historyId Int
  category  String           @default("PRIMARY")
  statKey   String
  statValue Float
  auditTrail String?
  history   HeroStatHistory @relation(fields: [historyId], references: [id])
}

model HeroHistoryEquipment {
  id             Int              @id @default(autoincrement())
  historyId      Int
  slotKey        String
  itemTemplateId Int?
  itemInstanceId Int?

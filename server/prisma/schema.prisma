  userQuestId Int
  key         String
  valStr      String?
  valInt      Int?
  valFloat    Float?
  valBool     Boolean?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userQuest   UserQuest @relation(fields: [userQuestId], references: [id])
  @@unique([userQuestId, key])
}

model GuildHistoryMeta {
  id         Int          @id @default(autoincrement())
  historyId  Int
  key        String
  valStr     String?
  valInt     Int?
  valFloat   Float?
  valBool    Boolean?

}

enum TournamentStatus {
  REGISTRATION
  CHECK_IN
  SEEDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  REGISTERED
  CHECKED_IN
  PLAYING
  ELIMINATED
  WITHDRAWN
}

enum AchievementCategory {
  COMBAT
  COLLECTION
  ECONOMY
  CRAFTING
  PVP
  EXPLORATION
  SOCIAL
  SPECIAL
}
